# Base URL of the Papo backend API.
# Leave empty for same-origin: production sits behind nginx, and in dev the
# Vite dev server proxies every API prefix to http://localhost:8080.
PUBLIC_API_URL=

# Base URL of the Papo WebSocket endpoint (e.g. ws://localhost:8080).
# Leave empty for same-origin: the dev proxy forwards /ws with ws: true and
# production uses the nginx websocket upgrade.
PUBLIC_WS_URL=

# GIPHY API key used by the client-side GIF picker.
PUBLIC_GIPHY_API_KEY=

# SFU receive-slot counts. Keep these equal to backend VOICE_VIDEO_SLOTS /
# VOICE_AUDIO_SLOTS so the initial WebRTC offer reserves the expected recvonly
# transceivers for camera/screen and routed audio.
PUBLIC_VOICE_VIDEO_SLOTS=6
PUBLIC_VOICE_AUDIO_SLOTS=8
